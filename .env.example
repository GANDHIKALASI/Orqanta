# ==============================================================================
# Orqanta — Environment Variables Configuration (.env.example)
# Copy this file to .env.local and fill in the values before running the application.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# Obtain from: https://supabase.com/dashboard/project/<project-id>/settings/api
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only service role key (NEVER expose to client, used strictly in server actions & bootstrap)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Resend Email Configuration
# Obtain from: https://resend.com/api-keys
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# ------------------------------------------------------------------------------
# Google Gemini AI Configuration
# Obtain free key without credit card: https://aistudio.google.com/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# ------------------------------------------------------------------------------
# Application URL
# In local development: http://localhost:3000
# In production: https://orqanta.app (or your Vercel deployment URL)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
